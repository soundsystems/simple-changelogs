{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "extends": ["ultracite/biome/core"],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    // Distributions ship the protocol schemas minified, byte for byte as
    // Simple Changes ships them; tooling keeps the readable copies.
    "includes": [
      "!docs/superpowers",
      "!skills/*/schemas/changelog-*.schema.json",
      "!skills/*/schemas/protocol-provenance.json"
    ]
  },
  "linter": {
    "domains": {
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  }
}
