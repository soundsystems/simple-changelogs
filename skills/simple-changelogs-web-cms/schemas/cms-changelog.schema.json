{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CMS Changelog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "kind", "title", "summary", "changes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "date": { "type": "string", "format": "date" },
          "version": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["release", "backfill"] },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "highlights": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "curation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["highlighted", "rolledUp", "omitted"],
            "properties": {
              "highlighted": { "$ref": "#/$defs/changeIds" },
              "rolledUp": { "$ref": "#/$defs/changeIds" },
              "omitted": { "$ref": "#/$defs/changeIds" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "changeIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{12}$" }
    }
  }
}
