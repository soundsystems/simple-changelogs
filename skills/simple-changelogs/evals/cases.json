                "status": "granted",
                "source": "current-request"
              }
            },
            {
              "kind": "file.changed",
              "target": "CHANGELOG.md",
              "expected": true
            },
            {
              "kind": "file.changed",
              "target": "DEVELOPER_CHANGELOG.md",
              "expected": true
            },
            {
              "kind": "text.notMatch",
              "target": "CHANGELOG.md",
              "expected": "Migrated the internal report queue to a new database table"
            },
            {
              "kind": "text.match",
              "target": "DEVELOPER_CHANGELOG.md",
              "expected": "Migrated the internal report queue to a new database table"
            },
            {
              "kind": "json.path",
              "target": ".simple-changelogs.json#/guidance/backfillStatus",
              "expected": "completed"
            },
            { "kind": "report.decision", "expected": "BACKFILL_COMPLETED" },
            {
              "kind": "report.verification",
              "expected": { "code": "BACKFILL_AUDIT", "status": "passed" }
            }
          ]
        }
      ]
