      "id": "behavior-guidance-driven-backfill-audit",
      "suite": "behavior",
      "fixture": "release-repo",
      "tags": ["backfill", "authorization", "lifecycle"],
      "activationMode": "explicit",
      "turns": [
        {
          "prompt": "Backfill all existing changelogs and release notes against the updated guidance.\nMove, delete, or refine entries until the history is clean.",
          "assertions": [
