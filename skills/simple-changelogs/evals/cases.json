    {
      "id": "behavior-release-metadata-drift",
      "suite": "behavior",
      "fixture": "release-repo",
      "tags": ["versions", "lifecycle"],
      "activationMode": "explicit",
      "turns": [
        {
          "prompt": "Finalize 0.12.0 by moving Unreleased into CHANGELOG.md and syncing the in-app\nrelease-note data.",
          "assertions": [
            {
              "kind": "json.path",
              "target": "package.json#/version",
              "expected": "0.12.0"
            },
            {
              "kind": "json.path",
              "target": "release-notes.json#/version",
              "expected": "0.12.0"
            },
            {
              "kind": "report.versionMap",
              "expected": {
                "path": "CHANGELOG.md",
                "role": "source",
                "version": "0.12.0"
              }
            },
            {
              "kind": "report.versionMap",
              "expected": {
                "path": "release-notes.json",
                "role": "mirror",
                "version": "0.12.0"
              }
            },
            {
              "kind": "report.versionMap",
              "expected": {
                "path": "packages/independent/package.json",
                "role": "package",
                "version": "3.0.0"
              }
            },
            {
              "kind": "report.verification",
              "expected": { "code": "VERSION_CONSISTENCY", "status": "passed" }
            },
            { "kind": "report.decision", "expected": "VERSION_SYNCED" }
          ]
        }
      ]
    },
