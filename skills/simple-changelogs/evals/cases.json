    {
      "id": "behavior-customer-visible-feature",
      "suite": "behavior",
      "fixture": "dual-changelog",
      "tags": ["setup", "wording", "customer", "developer"],
      "activationMode": "explicit",
      "turns": [
        {
          "prompt": "The diff adds a new saved-search screen, navigation entry, and backend endpoint.\nUpdate the changelogs for pending work.",
          "assertions": [
            {
              "kind": "file.changed",
              "target": "CHANGELOG.md",
              "expected": true
            },
            {
              "kind": "file.changed",
              "target": "DEVELOPER_CHANGELOG.md",
              "expected": true
            },
            {
              "kind": "text.match",
              "target": "CHANGELOG.md",
              "expected": "[Ss]aved [Ss]earch"
            },
            {
              "kind": "text.notMatch",
              "target": "CHANGELOG.md",
              "expected": "[Ee]ndpoint|[Aa][Pp][Ii] route"
            },
            {
              "kind": "path.exists",
              "target": ".simple-changelogs.json",
              "expected": true
            },
            { "kind": "report.decision", "expected": "CUSTOMER_ENTRY_ADDED" }
          ]
        }
      ]
    },
