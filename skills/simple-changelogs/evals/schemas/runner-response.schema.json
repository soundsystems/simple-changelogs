{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simple Changelogs Runner Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "status",
    "finalResponse",
    "evaluationReport"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "status": { "enum": ["completed", "skipped", "error"] },
    "finalResponse": { "type": "string" },
    "evaluationReport": { "$ref": "#/$defs/evaluationReport" },
    "runtimeIdentity": { "type": "string", "minLength": 1 },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "uppercaseCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "codeArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uppercaseCode" }
    },
    "authorizationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "source"],
      "properties": {
        "code": { "$ref": "#/$defs/uppercaseCode" },
        "status": {
          "enum": ["granted", "denied", "required", "not-applicable"]
        },
        "source": {
          "enum": [
            "current-request",
            "repository-policy",
            "repository-instructions",
            "user-response",
            "none"
          ]
        }
      }
    },
    "versionMapRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["source", "mirror", "package", "application", "store"]
        }
      }
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status"],
      "properties": {
        "code": { "$ref": "#/$defs/uppercaseCode" },
        "status": { "enum": ["passed", "failed", "not-run"] },
        "detail": { "type": "string" }
      }
    },
    "nativeActivationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activated", "trace"],
      "properties": {
        "activated": { "type": "boolean" },
        "trace": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evaluationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionCodes",
        "reasonCodes",
        "authorizationRecords",
        "versionMap",
        "verificationResults"
      ],
      "properties": {
        "decisionCodes": { "$ref": "#/$defs/codeArray" },
        "reasonCodes": { "$ref": "#/$defs/codeArray" },
        "authorizationRecords": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorizationRecord" }
        },
        "versionMap": {
          "type": "array",
          "items": { "$ref": "#/$defs/versionMapRecord" }
        },
        "verificationResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationResult" }
        },
        "nativeActivationEvidence": {
          "$ref": "#/$defs/nativeActivationEvidence"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/uppercaseCode" },
        "message": { "type": "string" }
      }
    }
  }
}
