{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/changelog-receipt-v2.schema.json",
  "title": "Simple Changelogs transaction receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "status",
    "transactionId",
    "releaseSetId",
    "phase",
    "observedAt",
    "sourceRevision",
    "revisionLineage",
    "effectivePolicyDigest",
    "decisionDigest",
    "paths",
    "checks",
    "evidence",
    "releaseImpact",
    "versionDecision",
    "release",
    "reasonCode",
    "requiredAction",
    "reason"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "provider": { "const": "simple-changelogs" },
    "status": {
      "enum": [
        "decision-required",
        "prepared",
        "verified",
        "not-applicable",
        "blocked"
      ]
    },
    "transactionId": { "type": "string", "minLength": 1 },
    "releaseSetId": { "type": ["string", "null"], "minLength": 1 },
    "phase": { "enum": ["classify", "prepare", "verify"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "revisionLineage": { "$ref": "#/$defs/revisionLineage" },
    "effectivePolicyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decisionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathDigest" }
    },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "releaseImpact": { "enum": ["none", "patch", "minor", "major", "unknown"] },
    "versionDecision": {
      "type": ["object", "null"],
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/versionDecision" }]
    },
    "release": {
      "type": ["object", "null"],
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }]
    },
    "reasonCode": {
      "enum": [
        null,
        "version-direction-required",
        "target-moved",
        "policy-changed",
        "release-train-ambiguous",
        "version-owner-ambiguous",
        "unsupported-protocol",
        "unsupported-consumer",
        "schema-digest-mismatch",
        "malformed-request",
        "malformed-policy",
        "invalid-version-direction",
        "final-verification-failed"
      ]
    },
    "requiredAction": {
      "enum": [
        null,
        "choose-version",
        "refresh-and-reclassify",
        "resolve-release-train",
        "resolve-version-owner",
        "upgrade-producer",
        "upgrade-consumer",
        "repair-integration",
        "repair-request",
        "repair-policy",
        "review-finalization"
      ]
    },
    "reason": { "type": ["string", "null"], "minLength": 1 }
  },
  "$defs": {
    "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" },
    "revisionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTargetRevision",
        "reconciliationHeadRevision",
        "finalizedTargetRevision"
      ],
      "properties": {
        "inputTargetRevision": { "$ref": "#/$defs/revision" },
        "reconciliationHeadRevision": { "$ref": "#/$defs/revision" },
        "finalizedTargetRevision": { "$ref": "#/$defs/revision" }
      }
    },
    "pathDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "versionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseTrain",
        "boundary",
        "currentVersion",
        "bumpLevel",
        "suggestedVersion",
        "selectedVersion",
        "policyAction",
        "resolution",
        "source"
      ],
      "properties": {
        "releaseTrain": { "type": "string", "minLength": 1 },
        "boundary": {
          "enum": [
            "release-bearing-merge",
            "web-production",
            "package-publication",
            "store-release",
            "other-public-release",
            "none"
          ]
        },
        "currentVersion": { "type": ["string", "null"] },
        "bumpLevel": { "enum": ["none", "patch", "minor", "major", "unknown"] },
        "suggestedVersion": { "type": ["string", "null"] },
        "selectedVersion": { "type": ["string", "null"] },
        "policyAction": { "enum": ["ask", "automatic", "not-applicable"] },
        "resolution": {
          "enum": [
            "not-required",
            "automatic",
            "explicit-direction",
            "repository-automation",
            "approval-required",
            "blocked"
          ]
        },
        "source": {
          "enum": [
            "current-request",
            "repository-policy",
            "run-only",
            "repository-convention"
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "targetContainedUnreleased"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "targetContainedUnreleased": { "enum": ["prepared", "integrated"] }
      }
    }
  }
}
