{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simple Changelogs Setup Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilities",
    "command",
    "status",
    "repository",
    "writeCapable",
    "onboardingRequired",
    "detection",
    "policy",
    "publicVersioning",
    "cmsPolicy",
    "globalPreferences",
    "guidanceUpdate",
    "inventory",
    "onboardingContribution",
    "recommendation",
    "ownerWriteReceipt",
    "selection",
    "unresolvedQuestions",
    "writes",
    "summary",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilities": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/capabilities" }]
    },
    "command": { "enum": ["inspect", "apply"] },
    "status": {
      "enum": [
        "already-configured",
        "blocked",
        "configured",
        "needs-input",
        "ready",
        "run-only"
      ]
    },
    "repository": { "type": "string", "minLength": 1 },
    "writeCapable": { "type": "boolean" },
    "onboardingRequired": { "type": "boolean" },
    "detection": { "$ref": "#/$defs/detection" },
    "policy": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/repoPolicyState" }]
    },
    "publicVersioning": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/publicVersioningResolution" }
      ]
    },
    "cmsPolicy": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cmsPolicyState" }]
    },
    "globalPreferences": { "$ref": "#/$defs/globalPreferencesState" },
    "guidanceUpdate": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/guidanceUpdate" }]
    },
    "inventory": { "$ref": "#/$defs/inventory" },
    "onboardingContribution": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/onboardingContribution" }
      ]
    },
    "recommendation": { "$ref": "#/$defs/recommendation" },
    "ownerWriteReceipt": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ownerWriteReceipt" }]
    },
    "selection": { "$ref": "#/$defs/selection" },
    "unresolvedQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "writes": {
      "type": "array",
      "items": { "$ref": "#/$defs/write" }
    },
    "summary": { "type": "string", "minLength": 1 },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "guidanceUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "recordedVersion",
        "currentVersion",
        "headline",
        "changes",
        "backfillRecommendation",
        "summary",
        "summaryBullets",
        "userPrompt",
        "walkthroughQuestion",
        "releaseNotesPath",
        "releaseNotesOffer"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["walkthrough", "continue", "view-release-notes"]
          }
        },
        "recordedVersion": { "type": "integer", "minimum": 1 },
        "currentVersion": { "type": "integer", "minimum": 1 },
        "headline": { "const": "Simple Changelogs has recently been updated." },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "kinds",
              "backfillRecommendation",
              "summary"
            ],
            "properties": {
              "version": { "type": "integer", "minimum": 1 },
              "kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "behavior",
                    "capability",
                    "onboarding",
                    "maintenance"
                  ]
                }
              },
              "backfillRecommendation": {
                "enum": ["recommended", "optional", "not-needed"]
              },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        },
        "backfillRecommendation": {
          "enum": ["recommended", "optional", "not-needed"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "summaryBullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "userPrompt": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "walkthroughQuestion": { "type": "string", "minLength": 1 },
        "releaseNotesPath": { "type": "string", "minLength": 1 },
        "releaseNotesOffer": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "provider",
        "distribution",
        "guidanceVersion",
        "requestVersions",
        "receiptVersions",
        "features",
        "schemaDigests"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "provider": { "const": "simple-changelogs" },
        "distribution": {
          "enum": ["full", "web", "mobile", "web-cms", "skill-repository"]
        },
        "guidanceVersion": { "type": "integer", "minimum": 1 },
        "requestVersions": { "const": [1] },
        "receiptVersions": { "const": [1, 2] },
        "features": {
          "const": [
            "public-version-policy",
            "classify-prepare-verify",
            "multi-train-receipts"
          ]
        },
        "schemaDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changelogRequest", "changelogReceipt"],
          "properties": {
            "changelogRequest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "changelogReceipt": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "backfillStatus": {
      "enum": [
        "not-applicable",
        "completed",
        "declined",
        "deferred",
        "partial",
        "failed"
      ]
    },
    "surfacePolicy": { "enum": ["ask", "allow", "existing-only"] },
    "surfaceComponentSource": {
      "enum": [
        "project-components",
        "recommended-web-components",
        "recommended-web-radix",
        "platform-native-components",
        "minimal-markup"
      ]
    },
    "mobileReleaseNotePlacement": {
      "enum": ["store-only", "web-tabs", "web-page", "mobile-only"]
    },
    "crossSurfaceVersioning": {
      "enum": ["shared", "independent", "mixed"]
    },
    "releaseNoteEnvironmentScope": {
      "enum": [
        "all-environments",
        "non-production",
        "production-only",
        "disabled"
      ]
    },
    "releaseNoteLinks": {
      "enum": ["when-useful", "ask", "disabled"]
    },
    "publicVersioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "minor", "major", "suggestWhenAsking"],
      "properties": {
        "patch": { "enum": ["ask", "automatic"] },
        "minor": { "enum": ["ask", "automatic"] },
        "major": { "enum": ["ask", "automatic"] },
        "suggestWhenAsking": { "type": "boolean" }
      }
    },
    "publicVersioningResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective", "recommended", "selected", "source", "stored"],
      "properties": {
        "effective": { "$ref": "#/$defs/publicVersioning" },
        "recommended": { "$ref": "#/$defs/publicVersioning" },
        "selected": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/publicVersioning" }]
        },
        "source": {
          "enum": ["missing-field-default", "repository-policy", "run-only"]
        },
        "stored": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/publicVersioning" }]
        }
      }
    },
    "repoPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "guidance",
        "developerChangelog",
        "signatures",
        "newReleaseNoteSurfaces"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "distribution": {
          "enum": ["full", "web", "mobile", "web-cms", "skill-repository"]
        },
        "guidance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "backfillStatus"],
          "properties": {
            "version": { "type": "integer", "minimum": 1 },
            "backfillStatus": { "$ref": "#/$defs/backfillStatus" }
          }
        },
        "developerChangelog": { "enum": ["required", "optional"] },
        "signatures": { "enum": ["agent-and-timestamp", "none"] },
        "newReleaseNoteSurfaces": { "$ref": "#/$defs/surfacePolicy" },
        "publicVersioning": { "$ref": "#/$defs/publicVersioning" },
        "newReleaseNoteSurfaceComponents": {
          "$ref": "#/$defs/surfaceComponentSource"
        },
        "mobileReleaseNotePlacement": {
          "$ref": "#/$defs/mobileReleaseNotePlacement"
        },
        "crossSurfaceVersioning": {
          "$ref": "#/$defs/crossSurfaceVersioning"
        },
        "releaseNoteEnvironmentScope": {
          "$ref": "#/$defs/releaseNoteEnvironmentScope"
        },
        "releaseNoteLinks": {
          "$ref": "#/$defs/releaseNoteLinks"
        }
      }
    },
    "cmsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "guidance",
        "changelogPath",
        "cmsSurface",
        "newReleaseNoteSurfaces"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "guidance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "backfillStatus"],
          "properties": {
            "version": { "const": 1 },
            "backfillStatus": { "$ref": "#/$defs/backfillStatus" }
          }
        },
        "changelogPath": { "type": "string", "minLength": 6 },
        "cmsSurface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "access"],
          "properties": {
            "route": { "type": "string", "pattern": "^/.+" },
            "access": { "const": "authenticated-operators" }
          }
        },
        "newReleaseNoteSurfaces": { "$ref": "#/$defs/surfacePolicy" },
        "publicVersioning": { "$ref": "#/$defs/publicVersioning" },
        "newReleaseNoteSurfaceComponents": {
          "$ref": "#/$defs/surfaceComponentSource"
        }
      }
    },
    "globalPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profile",
        "developerChangelog",
        "signatures",
        "newReleaseNoteSurfaces",
        "setupStyle"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "profile": { "const": "solo-developer" },
        "developerChangelog": { "enum": ["required", "optional"] },
        "signatures": { "enum": ["agent-and-timestamp", "none"] },
        "newReleaseNoteSurfaces": { "$ref": "#/$defs/surfacePolicy" },
        "setupStyle": { "enum": ["recommended", "customized"] }
      }
    },
    "stateBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "errors"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "state": { "enum": ["absent", "valid", "malformed"] },
        "errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repoPolicyState": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/stateBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "state", "errors"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "state": { "enum": ["absent", "malformed"] },
                "errors": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "errors", "value"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "state": { "const": "valid" },
            "errors": { "type": "array", "maxItems": 0 },
            "value": { "$ref": "#/$defs/repoPolicy" }
          }
        }
      ]
    },
    "cmsPolicyState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "errors"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "state": { "enum": ["absent", "malformed"] },
            "errors": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "errors", "value"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "state": { "const": "valid" },
            "errors": { "type": "array", "maxItems": 0 },
            "value": { "$ref": "#/$defs/cmsPolicy" }
          }
        }
      ]
    },
    "globalPreferencesState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "errors"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "state": { "enum": ["absent", "malformed"] },
            "errors": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "errors", "value"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "state": { "const": "valid" },
            "errors": { "type": "array", "maxItems": 0 },
            "value": { "$ref": "#/$defs/globalPreferences" }
          }
        }
      ]
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "confidence", "evidence"],
      "properties": {
        "distribution": {
          "enum": [
            null,
            "cms",
            "full",
            "web",
            "mobile",
            "web-cms",
            "skill-repository"
          ]
        },
        "confidence": { "enum": ["conflict", "high", "low", "medium"] },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjacentDestinations",
        "changelogs",
        "cmsEvidence",
        "designSystemEvidence",
        "destinations",
        "developerHistoryEvidence",
        "releasedHistoryCount",
        "surfaceStructureEvidence"
      ],
      "properties": {
        "adjacentDestinations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "changelogs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "exists", "releasedHeadings"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "exists": { "type": "boolean" },
              "releasedHeadings": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "cmsEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "designSystemEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "destinations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "developerHistoryEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "releasedHistoryCount": { "type": "integer", "minimum": 0 },
        "surfaceStructureEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cms", "mobile", "store", "web", "workspace"],
          "properties": {
            "cms": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "mobile": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "store": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "web": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "workspace": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "cmsPolicy", "reusableDefaults"],
      "properties": {
        "policy": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/repoPolicy" }]
        },
        "cmsPolicy": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cmsPolicy" }]
        },
        "reusableDefaults": { "$ref": "#/$defs/globalPreferences" }
      }
    },
    "onboardingContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "destination",
        "questions",
        "resolvedPolicy",
        "summary"
      ],
      "properties": {
        "owner": { "const": "simple-changelogs" },
        "destination": { "const": ".simple-changelogs.json" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "required"],
            "properties": {
              "id": {
                "enum": ["public-version-actions", "public-version-suggestions"]
              },
              "required": { "type": "boolean" }
            }
          }
        },
        "resolvedPolicy": { "$ref": "#/$defs/publicVersioning" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "ownerWriteReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "destination", "status", "written", "policyDigest"],
      "properties": {
        "owner": { "const": "simple-changelogs" },
        "destination": { "const": ".simple-changelogs.json" },
        "status": { "enum": ["completed", "not-requested"] },
        "written": { "type": "boolean" },
        "policyDigest": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backfillStatus": { "$ref": "#/$defs/backfillStatus" },
        "developerChangelog": { "enum": ["required", "optional"] },
        "mobileReleaseNotePlacement": {
          "$ref": "#/$defs/mobileReleaseNotePlacement"
        },
        "newReleaseNoteSurfaces": { "$ref": "#/$defs/surfacePolicy" },
        "newReleaseNoteSurfaceComponents": {
          "$ref": "#/$defs/surfaceComponentSource"
        },
        "crossSurfaceVersioning": {
          "$ref": "#/$defs/crossSurfaceVersioning"
        },
        "releaseNoteEnvironmentScope": {
          "$ref": "#/$defs/releaseNoteEnvironmentScope"
        },
        "releaseNoteLinks": {
          "$ref": "#/$defs/releaseNoteLinks"
        },
        "publicVersioning": { "$ref": "#/$defs/publicVersioning" },
        "scope": { "enum": ["repository", "all-projects", "run-only"] },
        "setupStyle": { "enum": ["recommended", "customized"] },
        "signatures": { "enum": ["agent-and-timestamp", "none"] }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "written"],
      "properties": {
        "kind": {
          "enum": [
            "changelog",
            "cms-changelog",
            "cms-policy",
            "developer-changelog",
            "global-preferences",
            "repository-policy"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "written": { "type": "boolean" }
      }
    }
  }
}
