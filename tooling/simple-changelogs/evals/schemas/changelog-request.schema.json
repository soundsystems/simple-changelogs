{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/changelog-request-v1.schema.json",
  "title": "Simple Changes changelog delegation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transactionId",
    "releaseSetId",
    "phase",
    "attempt",
    "releaseTrain",
    "boundary",
    "environment",
    "mutationScope",
    "inputTargetRevision",
    "finalizedTargetRevision",
    "approvedVersion",
    "approvedDecisionDigest",
    "priorReceiptDigest",
    "supportedReceiptVersions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transactionId": { "type": "string", "minLength": 1 },
    "releaseSetId": { "type": ["string", "null"], "minLength": 1 },
    "phase": { "enum": ["classify", "prepare", "verify"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "releaseTrain": { "type": "string", "minLength": 1 },
    "boundary": {
      "enum": [
        "release-bearing-merge",
        "web-production",
        "package-publication",
        "store-release",
        "other-public-release",
        "none"
      ]
    },
    "environment": { "type": ["string", "null"] },
    "mutationScope": { "enum": ["read-only", "prepare-release-files"] },
    "inputTargetRevision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "finalizedTargetRevision": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "approvedVersion": { "type": ["string", "null"], "minLength": 1 },
    "approvedDecisionDigest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "priorReceiptDigest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "supportedReceiptVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": [1, 2] }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "classify" } } },
      "then": {
        "properties": {
          "mutationScope": { "const": "read-only" },
          "finalizedTargetRevision": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "prepare" } } },
      "then": {
        "properties": {
          "mutationScope": { "const": "prepare-release-files" },
          "finalizedTargetRevision": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "verify" } } },
      "then": {
        "properties": {
          "mutationScope": { "const": "read-only" },
          "finalizedTargetRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          }
        }
      }
    }
  ]
}
