{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simple Changelogs Runner Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "status",
    "finalResponse",
    "evaluationReport"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "status": { "enum": ["completed", "skipped", "error"] },
    "finalResponse": { "type": "string" },
    "evaluationReport": { "$ref": "#/$defs/evaluationReport" },
    "runtimeIdentity": { "type": "string", "minLength": 1 },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "uppercaseCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "codeArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uppercaseCode" }
    },
    "authorizationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "source"],
      "properties": {
        "code": {
          "$ref": "#/$defs/uppercaseCode",
          "description": "Canonical authorization codes: GUIDANCE_BACKFILL, NEW_RELEASE_NOTE_SURFACE, RELEASED_HISTORY_REWRITE. Coin a new uppercase code only for an authority they do not cover."
        },
        "status": {
          "enum": ["granted", "denied", "required", "not-applicable"]
        },
        "source": {
          "enum": [
            "current-request",
            "repository-policy",
            "repository-instructions",
            "user-response",
            "none"
          ]
        }
      }
    },
    "versionMapRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["source", "mirror", "package", "application", "store"]
        }
      }
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status"],
      "properties": {
        "code": {
          "$ref": "#/$defs/uppercaseCode",
          "description": "Canonical verification codes: BACKFILL_AUDIT, RELEASE_NOTES_SYNC, SURFACE_SCOPE_FILTERING, VERSION_CONSISTENCY. Coin a new uppercase code only for a check they do not cover."
        },
        "status": { "enum": ["passed", "failed", "not-run"] },
        "detail": { "type": "string" }
      }
    },
    "nativeActivationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activated", "trace"],
      "properties": {
        "activated": { "type": "boolean" },
        "trace": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evaluationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionCodes",
        "reasonCodes",
        "authorizationRecords",
        "versionMap",
        "verificationResults"
      ],
      "properties": {
        "decisionCodes": {
          "$ref": "#/$defs/codeArray",
          "description": "Codes for the decisions made this turn. Use these canonical codes when they apply, and coin a new uppercase code only for a decision they do not cover: BACKFILL_COMPLETED, CUSTOMER_ENTRY_ADDED, CUSTOMER_ENTRY_OMITTED, DEVELOPER_ENTRY_ADDED, DEVELOPER_ENTRY_SUPERSEDED, EXPERT_RELEASE_LEDGER_UPDATED, FEATURE_GROUPED, FEATURE_NAMED, FORK_SYNCED, GUIDANCE_BACKFILL_COMPLETED, GUIDANCE_BACKFILL_REQUIRED, INITIAL_DEVELOPMENT_FIX_OMITTED, INITIAL_SETUP_REQUIRED, INTERNAL_SURFACE_CREATED, LOCAL_FORK_SELECTED, MAJOR_RELEASE_EXPERIENCE_CREATED, MAJOR_RELEASE_FINALIZED, MOBILE_SURFACE_CREATED, MODAL_DEPTH_REDUCED, MODAL_SEQUENCING_UPDATED, POLICY_NOTE_TERSE, PRERELEASE_FINALIZED, PUBLIC_DETAIL_REDACTED, PUBLIC_FIX_ADDED, RELEASE_BATCH_FINALIZED, RELEASE_FINALIZED, SIGNATURE_ADDED, SKILL_REFACTORED, STABLE_MAJOR_NOT_FINALIZED, STORE_NOTES_UPDATED, SURFACE_AUTHORIZATION_REQUIRED, SURFACE_CREATED, SURFACE_SCOPE_ISOLATED, UNRELEASED_RETAINED, VERSION_SYNCED."
        },
        "reasonCodes": { "$ref": "#/$defs/codeArray" },
        "authorizationRecords": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorizationRecord" }
        },
        "versionMap": {
          "type": "array",
          "items": { "$ref": "#/$defs/versionMapRecord" }
        },
        "verificationResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationResult" }
        },
        "nativeActivationEvidence": {
          "$ref": "#/$defs/nativeActivationEvidence"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/uppercaseCode" },
        "message": { "type": "string" }
      }
    }
  }
}
