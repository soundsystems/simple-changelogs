{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simple Changelogs Runner Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "case",
    "turnIndex",
    "prompt",
    "skillDirectory",
    "workspace",
    "activationMode",
    "timeoutMs",
    "responseSchema"
  ],
  "properties": {
    "protocolVersion": { "const": 2 },
    "case": {
      "$ref": "eval-manifest.schema.json#/$defs/evalCase"
    },
    "turnIndex": { "type": "integer", "minimum": 0 },
    "prompt": { "type": "string", "minLength": 1 },
    "skillDirectory": { "type": "string", "minLength": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "activationMode": { "enum": ["discover", "explicit"] },
    "timeoutMs": { "type": "integer", "minimum": 1 },
    "responseSchema": { "type": "string", "minLength": 1 },
    "transcript": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["user", "assistant"] },
        "content": { "type": "string" }
      }
    }
  }
}
