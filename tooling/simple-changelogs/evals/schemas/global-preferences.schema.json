{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simple Changelogs Solo-Developer Preferences",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "developerChangelog",
    "signatures",
    "newReleaseNoteSurfaces",
    "setupStyle"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "solo-developer" },
    "developerChangelog": { "enum": ["required", "optional"] },
    "majorReleaseNaming": { "enum": ["named", "version-only"] },
    "signatures": { "enum": ["agent-and-timestamp", "none"] },
    "newReleaseNoteSurfaces": {
      "enum": ["ask", "allow", "existing-only"]
    },
    "releaseNoteGrouping": { "enum": ["product-areas", "flat"] },
    "setupStyle": { "enum": ["recommended", "customized"] },
    "publicVersioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "minor", "major", "suggestWhenAsking"],
      "properties": {
        "patch": { "enum": ["ask", "automatic"] },
        "minor": { "enum": ["ask", "automatic"] },
        "major": { "enum": ["ask", "automatic"] },
        "suggestWhenAsking": { "type": "boolean" }
      }
    }
  }
}
