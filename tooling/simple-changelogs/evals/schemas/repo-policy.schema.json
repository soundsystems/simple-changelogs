{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simple Changelogs Repository Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "guidance",
    "developerChangelog",
    "signatures",
    "newReleaseNoteSurfaces"
  ],
  "allOf": [
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "guidance": {
                "properties": {
                  "version": { "minimum": 6 }
                },
                "required": ["version"]
              }
            },
            "required": ["guidance"]
          },
          {
            "anyOf": [
              {
                "properties": {
                  "distribution": { "const": "full" }
                },
                "required": ["distribution"]
              },
              {
                "not": { "required": ["distribution"] }
              }
            ]
          }
        ]
      },
      "then": {
        "required": ["mobileReleaseNotePlacement"]
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "distribution": {
      "enum": ["full", "web", "mobile", "web-cms", "skill-repository"]
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "backfillStatus"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "backfillStatus": {
          "enum": [
            "not-applicable",
            "completed",
            "declined",
            "deferred",
            "partial",
            "failed"
          ]
        }
      }
    },
    "developerChangelog": {
      "enum": ["required", "optional"]
    },
    "publicVersioning": {
      "$ref": "#/$defs/publicVersioning"
    },
    "mobileReleaseNotePlacement": {
      "enum": ["store-only", "web-tabs", "web-page", "mobile-only"]
    },
    "signatures": {
      "enum": ["agent-and-timestamp", "none"]
    },
    "newReleaseNoteSurfaces": {
      "enum": ["ask", "allow", "existing-only"]
    },
    "releaseNoteEnvironmentScope": {
      "enum": [
        "all-environments",
        "non-production",
        "production-only",
        "disabled"
      ]
    },
    "releaseNoteLinks": {
      "enum": ["when-useful", "ask", "disabled"]
    },
    "newReleaseNoteSurfaceComponents": {
      "enum": [
        "project-components",
        "recommended-web-components",
        "recommended-web-radix",
        "platform-native-components",
        "minimal-markup"
      ]
    },
    "crossSurfaceVersioning": {
      "enum": ["shared", "independent", "mixed"]
    }
  },
  "$defs": {
    "publicVersioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "minor", "major", "suggestWhenAsking"],
      "properties": {
        "patch": { "enum": ["ask", "automatic"] },
        "minor": { "enum": ["ask", "automatic"] },
        "major": { "enum": ["ask", "automatic"] },
        "suggestWhenAsking": { "type": "boolean" }
      }
    }
  }
}
